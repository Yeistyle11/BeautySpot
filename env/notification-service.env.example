NODE_ENV=production
PORT=3005
SERVICE_NAME=notification-service

DATABASE_URL=postgresql://beautyspot_notification:CAMBIAR@postgres:5432/beautyspot_notification
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR
RABBITMQ_URL=amqp://beautyspot:CAMBIAR@rabbitmq:5672

# Idéntico en los ocho servicios.
INTERNAL_API_SECRET=CAMBIAR
CORS_ORIGINS=https://beautyspot.co

CORE_SERVICE_URL=http://core-service:3002
APP_URL=https://beautyspot.co

# Con Gmail hace falta una contraseña de aplicación, no la de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CAMBIAR
SMTP_PASS=CAMBIAR
EMAIL_FROM=BeautySpot <noreply@beautyspot.co>

# OBLIGATORIO: debe ser IDENTICO al JWT_SECRET de auth-service. Este servicio
# no emite tokens, pero valida el de cada peticion y no arranca sin el.
JWT_SECRET=CAMBIAR
