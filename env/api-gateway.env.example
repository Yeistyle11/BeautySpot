NODE_ENV=production
PORT=3000
SERVICE_NAME=api-gateway

# Nombres de contenedor de la red de Docker, no localhost.
AUTH_SERVICE_URL=http://auth-service:3001
CORE_SERVICE_URL=http://core-service:3002
BOOKING_SERVICE_URL=http://booking-service:3003
PAYMENT_SERVICE_URL=http://payment-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005
MARKETPLACE_SERVICE_URL=http://marketplace-service:3006
ANALYTICS_SERVICE_URL=http://analytics-service:3007

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR
RABBITMQ_URL=amqp://beautyspot:CAMBIAR@rabbitmq:5672

# IDÉNTICO al de auth-service.
JWT_SECRET=CAMBIAR
# Idéntico en los ocho servicios.
INTERNAL_API_SECRET=CAMBIAR
CORS_ORIGINS=https://beautyspot.co

# Saltos de proxy de confianza. Hace falta para que el rate limit vea la IP real
# del cliente en X-Forwarded-For y no la del reverse proxy.
TRUST_PROXY=1

# Dominio de las cookies de sesion. Con el tenant por subdominio
# ({slug}.beautyspot.co) hay que fijarlo al dominio padre para que la sesion
# valga en todos. Vacio en desarrollo: el navegador usa el host exacto.
COOKIE_DOMAIN=.beautyspot.co

# Deben coincidir con los de auth-service: el gateway calcula con ellos la
# vida de cada cookie.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
