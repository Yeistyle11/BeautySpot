NODE_ENV=production
PORT=3001
SERVICE_NAME=auth-service

# Postgres vive en la red privada de Docker y no habla TLS; sin sslmode=disable
# el ORM exige TLS en producción y el servicio no conecta.
DATABASE_URL=postgresql://beautyspot_auth:CAMBIAR@postgres:5432/beautyspot_auth?sslmode=disable
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR
RABBITMQ_URL=amqp://beautyspot:CAMBIAR@rabbitmq:5672

# Idéntico en los ocho servicios.
INTERNAL_API_SECRET=CAMBIAR
CORS_ORIGINS=https://appbeautyspot.com

# Mínimo 32 caracteres. JWT_SECRET debe ser IDÉNTICO al del api-gateway;
# JWT_REFRESH_SECRET, distinto de JWT_SECRET. El servicio falla al arrancar si
# faltan o si conservan el valor de ejemplo.
JWT_SECRET=CAMBIAR
JWT_REFRESH_SECRET=CAMBIAR
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
