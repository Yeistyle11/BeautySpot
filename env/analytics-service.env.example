NODE_ENV=production
PORT=3007
SERVICE_NAME=analytics-service

DATABASE_URL=postgresql://beautyspot_analytics:CAMBIAR@postgres:5432/beautyspot_analytics
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR
RABBITMQ_URL=amqp://beautyspot:CAMBIAR@rabbitmq:5672

# Idéntico en los ocho servicios.
INTERNAL_API_SECRET=CAMBIAR
CORS_ORIGINS=https://beautyspot.co

# Se consulta para saber en que huso lee sus horas cada negocio, y con eso
# decidir donde empieza y termina su dia en las metricas.
CORE_SERVICE_URL=http://core-service:3002

# OBLIGATORIO: debe ser IDENTICO al JWT_SECRET de auth-service. Este servicio
# no emite tokens, pero valida el de cada peticion y no arranca sin el.
JWT_SECRET=CAMBIAR
