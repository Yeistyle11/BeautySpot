NODE_ENV=production
PORT=3002
SERVICE_NAME=core-service

# Postgres vive en la red privada de Docker y no habla TLS; sin sslmode=disable
# el ORM exige TLS en producción y el servicio no conecta.
DATABASE_URL=postgresql://beautyspot_core:CAMBIAR@postgres:5432/beautyspot_core?sslmode=disable
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR
RABBITMQ_URL=amqp://beautyspot:CAMBIAR@rabbitmq:5672

# Idéntico en los ocho servicios.
INTERNAL_API_SECRET=CAMBIAR
CORS_ORIGINS=https://appbeautyspot.com

# OBLIGATORIO: los servicios a los que este llama por HTTP interno. Sin una
# de ellas la llamada va a localhost, que dentro del contenedor es él mismo,
# y falla con "fetch failed".
AUTH_SERVICE_URL=http://auth-service:3001
BOOKING_SERVICE_URL=http://booking-service:3003

# Almacenamiento de las imágenes que suben los negocios. Por defecto en disco,
# en el volumen media_data del compose. Para llevarlas a un bucket S3 o
# Cloudflare R2: MEDIA_DRIVER=s3 y las AWS_* (AWS_ENDPOINT solo para R2/MinIO).
MEDIA_DRIVER=disco
MEDIA_DIR=/data/media
# AWS_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# AWS_S3_BUCKET=beautyspot-media

# OBLIGATORIO: debe ser IDENTICO al JWT_SECRET de auth-service. Este servicio
# no emite tokens, pero valida el de cada peticion y no arranca sin el.
JWT_SECRET=CAMBIAR
