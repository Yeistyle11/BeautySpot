NODE_ENV=production
PORT=3002
SERVICE_NAME=core-service

DATABASE_URL=postgresql://beautyspot_core:CAMBIAR@postgres:5432/beautyspot_core
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR
RABBITMQ_URL=amqp://beautyspot:CAMBIAR@rabbitmq:5672

# Idéntico en los ocho servicios.
INTERNAL_API_SECRET=CAMBIAR
CORS_ORIGINS=https://beautyspot.co

# Almacenamiento de imágenes.
AWS_ACCESS_KEY_ID=CAMBIAR
AWS_SECRET_ACCESS_KEY=CAMBIAR
AWS_REGION=us-east-1
AWS_S3_BUCKET=beautyspot-images
AWS_CDN_URL=https://cdn.beautyspot.co

# OBLIGATORIO: debe ser IDENTICO al JWT_SECRET de auth-service. Este servicio
# no emite tokens, pero valida el de cada peticion y no arranca sin el.
JWT_SECRET=CAMBIAR
