NODE_ENV=production
PORT=8080

# El gateway al que el servidor de Next reenvía /api/*. Lo resuelve el propio
# contenedor, no el navegador, así que aquí sí vale el nombre de servicio de la
# red de Docker: el gateway no necesita estar publicado.
#
# Las tres se leen tambien al construir la imagen: el rewrite de /api y las
# NEXT_PUBLIC_* quedan escritos en el build. Hay que pasarlas ademas como
# --build-arg (DEPLOY.md §2); cambiarlas solo aqui no llega a esas dos.
GATEWAY_URL=http://api-gateway:3000
NEXT_PUBLIC_SITE_URL=https://appbeautyspot.com
NEXT_PUBLIC_IMAGE_HOSTS=
