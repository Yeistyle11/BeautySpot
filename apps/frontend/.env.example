# Origen del gateway al que el servidor de Next reenvía /api/*. El navegador
# llama siempre a /api/v1 de su propio origen, así que esta variable no viaja
# al bundle y puede ser un nombre de contenedor.
GATEWAY_URL=http://localhost:3000

# URL pública del sitio, usada para construir enlaces absolutos.
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Hosts adicionales desde los que se permite optimizar imágenes, separados por
# comas. Se suman a la lista de next.config.js; las fotos las teclea cada
# negocio, así que un host no declarado se sirve sin optimizar.
NEXT_PUBLIC_IMAGE_HOSTS=
