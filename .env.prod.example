# Variables que interpola el propio docker-compose.prod.yml (no las lee ningún
# servicio: para eso están los ficheros de env/). Copiar a `.env` en la raíz.
#
#   cp .env.prod.example .env
#
# Ojo: las contraseñas de aquí tienen que coincidir con las de env/*.env.
# Postgres, Redis y RabbitMQ las usan para crear las credenciales; los servicios,
# para conectarse.

# Etiqueta de las 9 imágenes construidas (DEPLOY.md §2).
VERSION=1.0.0

# Superusuario de Postgres. Sólo lo usa el contenedor para inicializarse: los
# servicios se conectan cada uno con su propio usuario acotado.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR

# Una por servicio, las crea infra/docker/postgres/init.sh en el primer arranque
# del volumen. Si el volumen ya existe, cambiar esto NO tiene efecto.
BEAUTYSPOT_AUTH_PASSWORD=CAMBIAR
BEAUTYSPOT_CORE_PASSWORD=CAMBIAR
BEAUTYSPOT_BOOKING_PASSWORD=CAMBIAR
BEAUTYSPOT_PAYMENT_PASSWORD=CAMBIAR
BEAUTYSPOT_NOTIFICATION_PASSWORD=CAMBIAR
BEAUTYSPOT_MARKETPLACE_PASSWORD=CAMBIAR
BEAUTYSPOT_ANALYTICS_PASSWORD=CAMBIAR

REDIS_PASSWORD=CAMBIAR

RABBITMQ_USER=beautyspot
RABBITMQ_PASSWORD=CAMBIAR
