{{#> layout
  titulo="Tu cita se canceló"
  preheader="Puedes reservar otra hora cuando quieras."
  icono="calendario-x"
  negocio=businessName
  direccion=businessAddress
  telefono=businessPhone
  motivo=(concat "Recibes este correo porque tenías una cita en " businessName ".")
}}
  {{> estado tono="neutro" texto="Cancelada"}}
  {{> titulo texto="Tu cita se canceló"}}
  {{#> parrafo}}Hola {{primerNombre clientName}}, la cita que tenías en {{businessName}} ya no está en la agenda.{{/parrafo}}
  {{#> detalle}}
    {{> fila primera=true icono="tijeras" etiqueta="Servicio" valor=serviceName}}
    {{> fila icono="calendario" etiqueta="Era el" valor=(concat (diaCompleto appointmentDate) ", " (hora appointmentTime)) tachado=true}}
    {{#if reason}}{{> fila icono="info" etiqueta="Motivo" valor=reason}}{{/if}}
  {{/detalle}}
  {{> boton texto="Reservar otra cita" url=enlaceReservar}}
  {{#> nota}}Si crees que es un error, contacta con {{businessName}}{{#if businessPhone}} al <span style="white-space: nowrap;">{{businessPhone}}</span>{{/if}}.{{/nota}}
{{/layout}}
