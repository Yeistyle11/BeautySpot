{{#> layout
  titulo="Tu cita es en una hora"
  preheader=(concat "A las " (hora appointmentTime) " en " businessName ".")
  icono="reloj"
  negocio=businessName
  direccion=businessAddress
  telefono=businessPhone
  motivo=(concat "Recibes este correo porque tienes una cita en " businessName ".")
}}
  {{> titulo texto="Tu cita es en una hora"}}
  {{> hora hora=(hora appointmentTime) fecha=(concat "Hoy, " (diaCompleto appointmentDate))}}
  {{#> detalle}}
    {{> fila primera=true icono="tijeras" etiqueta="Servicio" valor=(concat serviceName " con " professionalName)}}
    {{#if businessAddress}}{{> fila icono="lugar" etiqueta="Dónde" valor=businessAddress}}{{/if}}
  {{/detalle}}
  {{#if enlaceMapa}}{{> boton texto="Cómo llegar" url=enlaceMapa}}{{/if}}
{{/layout}}
