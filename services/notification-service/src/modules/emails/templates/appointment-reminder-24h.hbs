{{#> layout
  titulo="Te esperamos mañana"
  preheader=(concat serviceName " con " professionalName " en " businessName ".")
  icono="campana"
  negocio=businessName
  direccion=businessAddress
  telefono=businessPhone
  motivo=(concat "Recibes este correo porque tienes una cita en " businessName ".")
}}
  {{> estado tono="info" texto="Mañana"}}
  {{> titulo texto=(concat "Te esperamos mañana a las " (hora appointmentTime))}}
  {{#> parrafo}}Hola {{primerNombre clientName}}, te recordamos tu cita. Llega unos 10 minutos antes para empezar a tiempo.{{/parrafo}}
  {{#> detalle}}
    {{> fila primera=true icono="tijeras" etiqueta="Servicio" valor=(conDuracion serviceName duration)}}
    {{> fila icono="calendario" etiqueta="Fecha" valor=(concat (diaCompleto appointmentDate) ", " (hora appointmentTime))}}
    {{> fila icono="persona" etiqueta="Te atiende" valor=professionalName}}
    {{#if businessAddress}}{{> fila icono="lugar" etiqueta="Dónde" valor=businessAddress}}{{/if}}
  {{/detalle}}
  {{#if enlaceCita}}
    {{> boton texto="Ver mi cita" url=enlaceCita secundario="Reagendar" urlSecundaria=enlaceReagendar}}
  {{else if enlaceMapa}}
    {{> boton texto="Cómo llegar" url=enlaceMapa}}
  {{/if}}
  {{#> nota}}Si no puedes venir, avisa antes: así otra persona puede usar ese hueco.{{/nota}}
{{/layout}}
