{{#> layout
  titulo="¿Qué tal tu visita?"
  preheader=(concat "Cuéntanos cómo te fue con " professionalName ". Es un minuto.")
  icono="estrella"
  negocio=businessName
  direccion=businessAddress
  telefono=businessPhone
  motivo=(concat "Recibes este correo porque te atendieron en " businessName ".")
}}
  {{> titulo texto=(concat "¿Qué tal tu visita, " (primerNombre clientName) "?")}}
  {{#> parrafo}}Gracias por venir. ¿Cómo te fue con {{professionalName}}? Tu opinión ayuda a otras personas a elegir y a {{businessName}} a mejorar.{{/parrafo}}
  {{> estrellas url=reviewLink}}
  {{> boton texto="Escribir mi reseña" url=reviewLink}}
  {{#> nota}}Tu reseña se publica con tu nombre en el perfil de {{businessName}}.{{/nota}}
{{/layout}}
