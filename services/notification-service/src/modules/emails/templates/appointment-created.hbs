{{#> layout
  titulo="Recibimos tu solicitud"
  preheader=(concat "Te avisaremos en cuanto " businessName " la confirme.")
  icono="calendario"
  negocio=businessName
  direccion=businessAddress
  telefono=businessPhone
  motivo=(concat "Recibes este correo porque pediste una cita en " businessName ".")
}}
  {{> estado tono="aviso" texto="Pendiente de confirmación"}}
  {{> titulo texto="Recibimos tu solicitud"}}
  {{#> parrafo}}Hola {{primerNombre clientName}}, ya tenemos tu reserva. {{businessName}} la revisará y te escribiremos en cuanto la confirme.{{/parrafo}}
  {{#> detalle}}
    {{> fila primera=true icono="tijeras" etiqueta="Servicio" valor=(conDuracion serviceName duration)}}
    {{> fila icono="calendario" etiqueta="Fecha" valor=(diaCompleto appointmentDate)}}
    {{> fila icono="reloj" etiqueta="Hora" valor=(hora appointmentTime)}}
    {{> fila icono="persona" etiqueta="Te atiende" valor=professionalName}}
  {{/detalle}}
  {{#if enlaceCita}}
    {{> boton texto="Ver mi cita" url=enlaceCita}}
    {{#> nota}}Si cambias de planes, puedes cancelar la solicitud desde tu cita.{{/nota}}
  {{else}}
    {{#> nota}}Si cambias de planes, avisa a {{businessName}}{{#if businessPhone}} al <span style="white-space: nowrap;">{{businessPhone}}</span>{{/if}}.{{/nota}}
  {{/if}}
{{/layout}}
