{{!--
  Factura emitida o recibo de un cobro sin comprobante propio. Los importes
  llegan ya como números; los formatea el ayudante `dinero`.
--}}
{{#> layout
  titulo=(concat (si esRecibo "Recibo" "Factura") " de " businessName)
  preheader=(concat "Total " (dinero total) ". Gracias por tu visita.")
  icono="factura"
  negocio=businessName
  direccion=businessAddress
  telefono=businessPhone
  motivo=(concat "Recibes este correo porque pagaste un servicio en " businessName ".")
}}
  {{> estado tono="exito" texto="Pagado"}}
  {{> titulo texto=(concat "Gracias por tu visita, " (primerNombre clientName))}}
  {{#> parrafo}}Aquí tienes {{#if esRecibo}}el recibo{{else}}la factura{{/if}} de tu pago en {{businessName}}.{{/parrafo}}

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border: 1px solid #E9E5F5; border-radius: 14px; border-collapse: separate; margin: 4px 0 24px;">
    <tr>
      <td colspan="2" align="center" style="padding: 18px 16px 12px; text-align: center;">
        <div style="font-size: 13px; color: #64748B;">Total pagado</div>
        <div style="font-size: 36px; line-height: 44px; font-weight: 700; letter-spacing: -0.8px; color: #5B21B6;">{{dinero total}}</div>
        <div style="font-size: 13px; color: #64748B;">{{#if esRecibo}}Recibo{{else}}Factura{{/if}} {{invoiceNumber}}{{#if invoiceDate}} · {{fecha invoiceDate}}{{/if}}</div>
      </td>
    </tr>
    {{#each items}}
    <tr>
      <td style="padding: 12px 18px; border-top: 1px solid #F1EEF8; font-size: 15px; color: #0F172A;">{{name}}</td>
      <td style="padding: 12px 18px; border-top: 1px solid #F1EEF8; font-size: 15px; color: #0F172A; text-align: right; white-space: nowrap;">{{dinero amount}}</td>
    </tr>
    {{/each}}
    {{#if tax}}
    <tr>
      <td style="padding: 12px 18px 4px; border-top: 1px solid #E9E5F5; font-size: 14px; color: #475569;">Subtotal</td>
      <td style="padding: 12px 18px 4px; border-top: 1px solid #E9E5F5; font-size: 14px; color: #475569; text-align: right; white-space: nowrap;">{{dinero subtotal}}</td>
    </tr>
    <tr>
      <td style="padding: 4px 18px 14px; font-size: 14px; color: #475569;">Impuesto</td>
      <td style="padding: 4px 18px 14px; font-size: 14px; color: #475569; text-align: right; white-space: nowrap;">{{dinero tax}}</td>
    </tr>
    {{/if}}
  </table>

  {{#if enlaceFacturas}}{{> boton texto="Ver mis facturas" url=enlaceFacturas}}{{/if}}
  {{#> nota}}¿Algún dato no es correcto? Contacta con {{businessName}}{{#if businessPhone}} al <span style="white-space: nowrap;">{{businessPhone}}</span>{{/if}} y lo corregirán.{{/nota}}
{{/layout}}
