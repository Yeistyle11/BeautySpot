{{!-- Resumen del mes para el dueño del negocio. Los importes llegan como números. --}}
{{#> layout
  titulo=(concat "Así fue " month " en " businessName)
  preheader=(concat (dinero totalRevenue) " de ingresos y " totalAppointments " citas en " month ".")
  icono="grafica"
  motivo=(concat "Recibes este resumen porque eres dueño de " businessName " en BeautySpot.")
}}
  {{> estado tono="marca" texto=(concat month " " year)}}
  {{> titulo texto=(concat "Así fue " month " en " businessName)}}
  {{#> parrafo}}Hola {{primerNombre clientName}}, este es el resumen del mes. El detalle completo está en Reportes.{{/parrafo}}

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 20px;">
    <tr>
      <td class="bs-columna" width="50%" style="width: 50%; padding: 4px; vertical-align: top;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
          <td align="center" style="border: 1px solid #E9E5F5; border-radius: 14px; padding: 16px; text-align: center;">
            <img src="{{@root.recursos}}/icono-dinero.png" width="20" height="20" alt="" style="display: inline-block; border: 0;">
            <div style="padding-top: 6px; font-size: 26px; line-height: 32px; font-weight: 700; color: #0F172A;">{{dinero totalRevenue}}</div>
            <div style="font-size: 13px; color: #475569;">Ingresos</div>
          </td>
        </tr></table>
      </td>
      <td class="bs-columna" width="50%" style="width: 50%; padding: 4px; vertical-align: top;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
          <td align="center" style="border: 1px solid #E9E5F5; border-radius: 14px; padding: 16px; text-align: center;">
            <img src="{{@root.recursos}}/icono-calendario-check.png" width="20" height="20" alt="" style="display: inline-block; border: 0;">
            <div style="padding-top: 6px; font-size: 26px; line-height: 32px; font-weight: 700; color: #0F172A;">{{totalAppointments}}</div>
            <div style="font-size: 13px; color: #475569;">Citas</div>
          </td>
        </tr></table>
      </td>
    </tr>
  </table>

  {{#if topService}}
  {{#> detalle}}
    {{> fila primera=true icono="estrella" etiqueta="Servicio estrella" valor=(concat topService " · " (dinero topServiceRevenue))}}
  {{/detalle}}
  {{/if}}
  {{> boton texto="Ver reportes" url=enlaceReportes}}
{{/layout}}
