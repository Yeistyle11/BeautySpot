{{#> layout
  titulo="Tu cita está confirmada"
  preheader=(concat "Te esperamos el " (diaCompleto appointmentDate) " a las " (hora appointmentTime) " con " professionalName ".")
  icono="calendario-check"
  negocio=businessName
  direccion=businessAddress
  telefono=businessPhone
  motivo=(concat "Recibes este correo porque reservaste una cita en " businessName ".")
}}
  {{> estado tono="exito" texto="Confirmada"}}
  {{> titulo texto="Tu cita está confirmada"}}
  {{#> parrafo}}Hola {{primerNombre clientName}}, {{professionalName}} te espera. Guarda la cita en tu calendario para no olvidarla.{{/parrafo}}
  {{#> detalle}}
    {{> fila primera=true icono="tijeras" etiqueta="Servicio" valor=(conDuracion serviceName duration)}}
    {{> fila icono="calendario" etiqueta="Fecha" valor=(diaCompleto appointmentDate)}}
    {{> fila icono="reloj" etiqueta="Hora" valor=(hora appointmentTime)}}
    {{> fila icono="persona" etiqueta="Te atiende" valor=professionalName}}
    {{#if businessAddress}}{{> fila icono="lugar" etiqueta="Dónde" valor=businessAddress}}{{/if}}
  {{/detalle}}
  {{#if enlaceMapa}}
    {{> boton texto="Añadir al calendario" url=enlaceCalendario secundario="Cómo llegar" urlSecundaria=enlaceMapa}}
  {{else}}
    {{> boton texto="Añadir al calendario" url=enlaceCalendario}}
  {{/if}}
  {{#if enlaceCita}}
    {{#> nota}}¿No puedes ir? <a href="{{enlaceCita}}" style="color: #6D28D9;">Reagenda o cancela desde tu cita</a>, con antelación.{{/nota}}
  {{else}}
    {{#> nota}}¿No puedes ir? Avisa a {{businessName}}{{#if businessPhone}} al <span style="white-space: nowrap;">{{businessPhone}}</span>{{/if}} con antelación.{{/nota}}
  {{/if}}
{{/layout}}
