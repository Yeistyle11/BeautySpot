{{!
  Cinco estrellas que llevan al formulario con la nota ya puesta. Parámetro:
  url, a la que se añade «?calificacion=N».
}}
<table
  role="presentation"
  cellpadding="0"
  cellspacing="0"
  border="0"
  align="center"
  style="margin: 4px auto 8px;"
>
  <tr>
    <td style="padding: 0 4px;"><a
        href="{{url}}?calificacion=1"
        target="_blank"
      ><img
          src="{{@root.recursos}}/estrella.png"
          width="44"
          height="44"
          alt="1 estrella"
          style="display: block; border: 0;"
        /></a></td>
    <td style="padding: 0 4px;"><a
        href="{{url}}?calificacion=2"
        target="_blank"
      ><img
          src="{{@root.recursos}}/estrella.png"
          width="44"
          height="44"
          alt="2 estrellas"
          style="display: block; border: 0;"
        /></a></td>
    <td style="padding: 0 4px;"><a
        href="{{url}}?calificacion=3"
        target="_blank"
      ><img
          src="{{@root.recursos}}/estrella.png"
          width="44"
          height="44"
          alt="3 estrellas"
          style="display: block; border: 0;"
        /></a></td>
    <td style="padding: 0 4px;"><a
        href="{{url}}?calificacion=4"
        target="_blank"
      ><img
          src="{{@root.recursos}}/estrella.png"
          width="44"
          height="44"
          alt="4 estrellas"
          style="display: block; border: 0;"
        /></a></td>
    <td style="padding: 0 4px;"><a
        href="{{url}}?calificacion=5"
        target="_blank"
      ><img
          src="{{@root.recursos}}/estrella.png"
          width="44"
          height="44"
          alt="5 estrellas"
          style="display: block; border: 0;"
        /></a></td>
  </tr>
</table>
<p
  style="margin: 0 0 24px; text-align: center; font-size: 13px; color: #64748B;"
>Toca una estrella y escribe tu reseña en un minuto.</p>